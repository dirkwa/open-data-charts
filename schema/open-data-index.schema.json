{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirkwa.github.io/open-data-charts/open-data-index.schema.json",
  "title": "Open Data Charts index",
  "description": "Every published chart unit. Not for navigation. Consumers ignore unknown fields and skip entries they cannot read.",
  "type": "object",
  "required": ["schemaVersion", "generated", "disclaimer", "regions", "units"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generated": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string" },
    "attribution": { "type": "string" },
    "license": { "type": "string", "description": "Licence id (from licenses) of every unit file as a whole" },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "attribution": { "type": "string" }
        }
      }
    },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "description": "[west, south, east, north] in degrees",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "region": {
      "type": "object",
      "required": ["id", "name", "bbox"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "overview": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["url", "sha256", "size", "version", "minzoom", "maxzoom"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "sha256": { "$ref": "#/$defs/sha256" },
                "size": { "type": "integer", "minimum": 0 },
                "version": { "type": "string" },
                "minzoom": { "type": "integer" },
                "maxzoom": { "type": "integer" }
              }
            }
          ]
        },
        "sources": { "type": "array", "items": { "type": "string" } },
        "attribution": { "type": "string", "description": "Attribution of this region's units" }
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "region", "z", "x", "y", "bbox", "version", "url", "size", "sha256", "minzoom", "maxzoom"],
      "properties": {
        "id": { "type": "string", "pattern": "^z[0-9]+-[0-9]+-[0-9]+$" },
        "region": { "type": "string" },
        "z": { "type": "integer" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "version": { "type": "string", "pattern": "^[0-9a-f]+$" },
        "url": { "type": "string", "format": "uri" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "minzoom": { "type": "integer" },
        "maxzoom": { "type": "integer" },
        "built": { "type": "string", "format": "date" },
        "quality": {
          "type": "object",
          "required": ["best", "share"],
          "properties": {
            "best": { "type": "string" },
            "share": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        "surveys": { "type": "integer", "minimum": 0 },
        "changes": { "type": "string" }
      }
    }
  }
}
